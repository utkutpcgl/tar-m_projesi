+    def create_local_shadow_casters(self, collection):
+        fraction = min(
+            0.60,
+            max(
+                0.0,
+                float(
+                    os.environ.get(
+                        "CROPCRAFT_SURFACE_LOCAL_SHADOW_FRACTION", "0.0"
+                    )
+                ),
+            ),
+        )
+        if fraction <= 0.0:
+            return
+        seed = int(float(os.environ.get("CROPCRAFT_SURFACE_SHADOW_SEED", "0")))
+        rng = random.Random(seed)
+        count = 1 + int(fraction >= 0.20) + int(fraction >= 0.40)
+        total_width = self.beds.length + 2.0 * self.field.headland_width
+        total_length = self.beds.width + 2.0 * self.field.headland_width
+        for index in range(count):
+            caster = create_plane_object(
+                f"local_shadow_caster_{index:02d}",
+                total_length * rng.uniform(0.18, 0.44),
+                total_width * max(0.08, fraction / count) * rng.uniform(0.7, 1.3),
+                0.0,
+            )
+            caster.location = (
+                rng.uniform(-0.25, 0.75) * total_width,
+                rng.uniform(-0.25, 0.75) * total_length,
+                2.5 + 0.25 * index,
+            )
+            caster.rotation_euler[2] = rng.uniform(0.0, math.tau)
+            material = bpy.data.materials.new(f"shadow_caster_{index:02d}")
+            material.diffuse_color = (0.06, 0.07, 0.05, 1.0)
+            caster.active_material = material
+            caster.visible_camera = False
+            collection.objects.link(caster)
+
